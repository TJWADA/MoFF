# MoFF runs entirely on checked-in fixtures by default. Nothing here is
# required to start the app -- copy to .env.local only when you want live data.

# fixture (default) | live
MOFF_MODE=fixture

# Local SQLite file in dev; a Turso libsql:// URL in production.
DATABASE_URL=file:.moff/moff.db
# DATABASE_AUTH_TOKEN=

# Free Basic tier is enough: split/dividend-adjusted daily bars back to 2016.
# The same keys drive the optional paper-trading step.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# Structured extraction of trade calls from transcripts.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Transcript fetching. Without this, transcripts stay on fixtures.
# SUPADATA_API_KEY=
