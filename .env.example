# YouTube lookup needs no keys (uses YouTube's public web client).

# Required on the video page to fetch transcripts:
# SUPADATA_API_KEY=

# Required to extract trade calls from a transcript:
# OPENAI_API_KEY=

# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Required to check how extracted trades did (Alpaca market data):
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
